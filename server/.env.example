# 可选。MCP 默认用宿主 Agent 自己的视觉模型，不需要这里的 key。
# 复制为 server/.env 或仓库根目录 .env。不要把真密码、真 key 提交进仓库。
HOST=127.0.0.1
PORT=8890
HIDAGENT_DEBUG=0

# 中文/数字粘贴：按 docs/PASTE_INPUT.md 设置领取与完成确认快捷指令。
# BASE_URL、KEY 都留空则仅 ASCII 逐键输入。
# 单独启动局域网剪贴板代理：python -m hidagent.clipboard_proxy --host 0.0.0.0 --port 8891
# 控制服务保持上面的回环地址 127.0.0.1:8890；双终端步骤见 docs/PASTE_INPUT.md。
# HIDAGENT_CLIPBOARD_BASE_URL=http://computer.local:8891
# HIDAGENT_CLIPBOARD_KEY=（用 secrets.token_urlsafe(32) 生成，不要使用此占位符）
# 手机全键盘控制须绑定相同组合键；省略此项则由人触发领取。
# HIDAGENT_CLIPBOARD_TRIGGER_KEY=ctrl+alt+p
# TTL 包含复制、焦点和粘贴完成的人工确认时间。
# HIDAGENT_CLIPBOARD_TTL=60
# CLI/MCP 进程的超时需大于 TTL + 5 秒。
# IPHONE_AGENT_TIMEOUT=70

# 留空则自动找 CH343 / FTDI / CP210x。例如 COM5、/dev/cu.usbserial-A5069RR4 或 /dev/cu.wchusbserial110
# HIDAGENT_PORT=

# 留空则用串口 netinfo 里的 IP 和 vtok。一般不用填。
# BOARD_HOST=
# BOARD_VTOK=
# VIDEO_FPS=8

# 只有 Mac 上、板载镜像失败时才改成 uxplay。Windows 不要设这个。
# SCREEN_BACKEND=board

# 只有明确要让服务端自己调模型时才填写（还要设 IPHONE_MCP_ENABLE_DELEGATE=1）。
# 推荐：宿主 Agent 自带视觉模型。若走这里，换更快的视觉模型是提速最直接的办法。
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-vision-model
# LLM_API_KEY=
# LLM_EXTRA_BODY={}
