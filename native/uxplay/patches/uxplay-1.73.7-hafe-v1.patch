+#include "hafe_stream.hpp"
+#include <chrono>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdexcept>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace {
+void be(unsigned char *out, uint64_t value, size_t bytes) {
+    for (size_t i = bytes; i; --i) { out[i-1] = value & 255; value >>= 8; }
+}
+}
+HafeWriter::HafeWriter(int fd): fd_(fd) {
+    struct stat st;
+    int flags = fcntl(fd_, F_GETFL);
+    if (fd_ < 3 || flags < 0 || (flags & O_ACCMODE) == O_RDONLY ||
+        fstat(fd_, &st) < 0 || !S_ISFIFO(st.st_mode) ||
+        fcntl(fd_, F_SETFL, flags | O_NONBLOCK) < 0) {
+        throw std::runtime_error("invalid HAFE output descriptor");
+    }
+    /* This opt-in process owns the dedicated output pipe. Broken consumers
+       must invalidate it, never terminate midway and silently restart raw JPEG. */
+    signal(SIGPIPE, SIG_IGN);
+}
+HafeWriter::~HafeWriter() { if (fd_ >= 0) close(fd_); }
+void HafeWriter::fail() {
+    if (fd_ >= 0) close(fd_);
+    fd_ = -1; active_ = 0;
+}
+bool HafeWriter::record(unsigned char kind, uint64_t epoch, uint64_t seq,
+                        const unsigned char *data, size_t length, uint32_t capture_ms) {
+    if (fd_ < 0) return false;
+    unsigned char header[32] = {'H','A','F','E',2,kind,0,0};
+    be(header+8, epoch, 8); be(header+16, seq, 8); be(header+24, length, 4);
+    be(header+28, capture_ms, 4);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+    for (int part = 0; part < 2; ++part) {
+        const unsigned char *bytes = part ? data : header;
+        size_t left = part ? length : sizeof(header);
+        while (left) {
+            auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+                deadline - std::chrono::steady_clock::now()).count();
+            if (remaining <= 0) { fail(); return false; }
+            pollfd poller = {fd_, POLLOUT, 0};
+            int ready = poll(&poller, 1, static_cast<int>(remaining));
+            if (ready < 0 && errno == EINTR) continue;
+            if (ready <= 0 || !(poller.revents & POLLOUT) ||
+                (poller.revents & (POLLERR | POLLHUP | POLLNVAL))) { fail(); return false; }
+            ssize_t count = write(fd_, bytes, left);
+            if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) continue;
+            if (count <= 0) { fail(); return false; }
+            bytes += count; left -= count;
+        }
+    }
+    return true;
+}
+uint64_t HafeWriter::begin() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (fd_ < 0) return 0;
+    if (active_ && !record(3, active_, 0, nullptr, 0, 0)) return 0;
+    if (next_ == UINT64_MAX) { fail(); return 0; }
+    active_ = ++next_; sequence_ = 0;
+    return record(1, active_, 0, nullptr, 0, 0) ? active_ : 0;
+}
+bool HafeWriter::jpeg(uint64_t epoch, const unsigned char *data, size_t length,
+                    uint32_t capture_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!epoch || epoch != active_ || fd_ < 0) return false;
+    if (!data || length < 4 || length > MAX_JPEG || data[0] != 0xff ||
+        data[1] != 0xd8 || data[length-2] != 0xff || data[length-1] != 0xd9 ||
+        sequence_ == UINT64_MAX) { fail(); return false; }
+    return record(2, epoch, ++sequence_, data, length, capture_ms);
+}
+void HafeWriter::end(uint64_t epoch) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!epoch || epoch != active_) return;
+    record(3, epoch, 0, nullptr, 0, 0); active_ = 0;
+}
+bool HafeWriter::healthy() {
+    std::lock_guard<std::mutex> lock(mutex_); return fd_ >= 0;
+}
