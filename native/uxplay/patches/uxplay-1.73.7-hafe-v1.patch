+++ b/renderers/hafe_stream.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+/* HAFE v2: 32-byte network-order header, then bounded JPEG payload.
+   Header bytes 28-31 carry the JPEG capture time (monotonic ms, 0 =
+   unknown); v1 records have that field zero and are still accepted. */
+class HafeWriter {
+public:
+    static const size_t MAX_JPEG = 8 * 1024 * 1024;
+    explicit HafeWriter(int fd);
+    ~HafeWriter();
+    uint64_t begin();
+    bool jpeg(uint64_t immutable_epoch, const unsigned char *data, size_t length,
+            uint32_t capture_ms);
+    void end(uint64_t immutable_epoch);
+    bool healthy();
+private:
+    bool record(unsigned char kind, uint64_t epoch, uint64_t seq,
+                const unsigned char *data, size_t length, uint32_t capture_ms);
+    void fail();
+    std::mutex mutex_;
+    int fd_;
+    uint64_t next_ = 0, active_ = 0, sequence_ = 0;
+};
