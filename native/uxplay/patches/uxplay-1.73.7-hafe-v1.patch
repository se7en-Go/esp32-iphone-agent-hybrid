@@ -0,0 +1,128 @@
+#include "hafe_renderer.h"
+#include "hafe_stream.hpp"
+#include <gst/gst.h>
+#include <gst/app/gstappsrc.h>
+#include <gst/app/gstappsink.h>
+#include <climits>
+#include <cstdlib>
+#include <memory>
+#include <string>
+
+static std::unique_ptr<HafeWriter> writer;
+struct HafeSession {
+    /* Overwritten only by the overload recovery in hafe_process, which ends
+       the old epoch and starts a fresh one. Every appsink owns this context. */
+    uint64_t epoch;
+    GstElement *pipeline = nullptr, *source = nullptr;
+    bool h265 = false;
+    explicit HafeSession(uint64_t value): epoch(value) {}
+};
+static GstFlowReturn sample(GstAppSink *sink, gpointer opaque) {
+    HafeSession *session = static_cast<HafeSession *>(opaque);
+    GstSample *value = gst_app_sink_pull_sample(sink);
+    if (!value) return GST_FLOW_EOS;
+    GstBuffer *buffer = gst_sample_get_buffer(value);
+    GstMapInfo map;
+    bool written = false;
+    if (buffer && gst_buffer_map(buffer, &map, GST_MAP_READ)) {
+        /* HAFE v2: stamp the frame with its capture time (pipeline
+           clock, monotonic ms). A frame that waited in the decode
+           queue keeps its old timestamp, so the Python side can drop
+           it instead of publishing it as fresh. 0 = no timestamp. */
+        uint32_t capture_ms = 0;
+        GstClockTime pts = GST_BUFFER_PTS(buffer);
+        if (GST_CLOCK_TIME_IS_VALID(pts) && session->pipeline) {
+            GstClockTime base = gst_element_get_base_time(session->pipeline);
+            if (GST_CLOCK_TIME_IS_VALID(base))
+                capture_ms = static_cast<uint32_t>(((pts + base) / 1000000) & 0xffffffff);
+        }
+        written = writer->jpeg(session->epoch, map.data, map.size, capture_ms);
+        gst_buffer_unmap(buffer, &map);
+    }
+    gst_sample_unref(value);
+    return written ? GST_FLOW_OK : GST_FLOW_FLUSHING;
+}
+extern "C" int hafe_configure_from_env(void) {
+    const char *value = getenv("HIDAGENT_UXPLAY_FRAMED_FD");
+    if (!value) return 0;
+    if (!*value) return -1;
+    for (const char *p = value; *p; ++p) if (*p < '0' || *p > '9') return -1;
+    char *end; long fd = strtol(value, &end, 10);
+    if (*end || fd < 3 || fd > INT_MAX) return -1;
+    try { writer.reset(new HafeWriter(static_cast<int>(fd))); }
+    catch (...) { return -1; }
+    gst_init(nullptr, nullptr);
+    return 1;
+}
+extern "C" void *hafe_begin(void *) {
+    uint64_t epoch = writer->begin();
+    return epoch ? new HafeSession(epoch) : nullptr;
+}
+extern "C" void hafe_end(void *, void *opaque) {
+    HafeSession *session = static_cast<HafeSession *>(opaque);
+    if (!session) return;
+    /* Invalidate first, then wait for this pipeline's callbacks to finish. */
+    writer->end(session->epoch);
+    if (session->pipeline) {
+        gst_element_set_state(session->pipeline, GST_STATE_NULL);
+        gst_object_unref(session->source);
+        gst_object_unref(session->pipeline);
+    }
+    delete session;
+}
+extern "C" void hafe_process(void *opaque, video_decode_struct *data) {
+    HafeSession *session = static_cast<HafeSession *>(opaque);
+    if (!session || !writer->healthy() || data->data_len <= 0 || data->data_len > 8*1024*1024) return;
+    if (!session->pipeline) {
+        session->h265 = data->is_h265;
+        const std::string codec = session->h265 ? "h265" : "h264";
+        std::string pipeline = "appsrc name=hafe_source is-live=true format=time do-timestamp=true "
+            "max-bytes=8388608 block=false ! queue max-size-buffers=16 max-size-bytes=8388608 "
+            "max-size-time=0 leaky=no ! " + codec + "parse config-interval=-1 ! avdec_" + codec +
+            " ! videoconvert ! jpegenc quality=75 ! appsink name=hafe_sink "
+            "emit-signals=true sync=false max-buffers=1 drop=true";
+        GError *error = nullptr;
+        session->pipeline = gst_parse_launch(pipeline.c_str(), &error);
+        if (error || !session->pipeline) {
+            if (error) g_error_free(error);
+            if (session->pipeline) gst_object_unref(session->pipeline);
+            session->pipeline = nullptr; writer->end(session->epoch); return;
+        }
+        session->source = gst_bin_get_by_name(GST_BIN(session->pipeline), "hafe_source");
+        GstElement *sink = gst_bin_get_by_name(GST_BIN(session->pipeline), "hafe_sink");
+        GstCaps *caps = gst_caps_new_simple(("video/x-"+codec).c_str(),
+            "stream-format", G_TYPE_STRING, "byte-stream", "alignment", G_TYPE_STRING, "au", nullptr);
+        gst_app_src_set_caps(GST_APP_SRC(session->source), caps); gst_caps_unref(caps);
+        g_signal_connect(sink, "new-sample", G_CALLBACK(sample), session);
+        gst_object_unref(sink);
+        if (gst_element_set_state(session->pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+            writer->end(session->epoch); return;
+        }
+    }
+    if (session->h265 != data->is_h265) { writer->end(session->epoch); return; }
+    /* appsrc max-bytes alone is advisory when block=false; check actual queue. */
+    guint64 queued = 0;
+    g_object_get(session->source, "current-level-bytes", &queued, nullptr);
+    if (queued + static_cast<guint64>(data->data_len) > 8*1024*1024) {
+        /* Overload recovery: the backed-up pipeline can never catch up,
+           and ending the session would freeze the mirror until a new
+           AirPlay connection. Tear the pipeline down and start a fresh
+           epoch; the decoder restarts and the phone's next IDR re-syncs
+           it. The Python side treats the new epoch as a new session
+           (generation bump, old screen_id rejected). */
+        if (session->pipeline) {
+            gst_element_set_state(session->pipeline, GST_STATE_NULL);
+            gst_object_unref(session->source);
+            gst_object_unref(session->pipeline);
+            session->pipeline = nullptr;
+            session->source = nullptr;
+        }
+        uint64_t epoch = writer->begin();
+        if (epoch) session->epoch = epoch;
+        return;
+    }
+    GstBuffer *buffer = gst_buffer_new_allocate(nullptr, data->data_len, nullptr);
+    gst_buffer_fill(buffer, 0, data->data, data->data_len);
+    if (gst_app_src_push_buffer(GST_APP_SRC(session->source), buffer) != GST_FLOW_OK)
+        writer->end(session->epoch);
+}
